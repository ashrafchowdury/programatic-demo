# Dependencies / build
node_modules
dist
.remotion

# OS / editor cruft
.DS_Store
*.swp

# Secrets — never commit
.env
.env.local
# Stored logins. .sessions/ holds one snapshot per host; storageState.json
# is the legacy single-file form it replaced.
storageState.json
.sessions
.session-profile

# --- Pipeline artifacts ----------------------------------------------------
# Everything below is REGENERATED by the pipeline. The repo holds the code that
# produces demos, not the demos themselves: a recording is hundreds of MB, is
# specific to one account's data, and goes stale the moment the app changes.
#
#   recordings/  raw Playwright capture   -> pnpm record:* / record:batch
#   public/      converted mp4 + clicklog -> pnpm convert <name>
#   out/         final rendered clips     -> pnpm render <name>
#   tours/       captured click tours     -> DEMO_TOUR=capture
#   .diag/       failure-only screenshots -> written by the recorders
out
recordings
public/*.mp4
public/*.webm
public/*.clicks.json
public/audio/
tours/*.json
.diag

# --- Account-specific demo flows -------------------------------------------
# The ENGINE is open source; the demos driven through it are not. Every flow
# below is written against one app workspace: it hardcodes that account's
# playground URL, its agent names, and selectors for data only that account has.
# They would not run for anyone else and they describe private content.
#
# Keep your own demos here — the directory is ignored, not the concept.
# The three flows that ARE committed are deliberately generic:
#   smoke.ts           offline fixture; `pnpm clip:smoke` is the install check
#   google-search.ts   public site, no auth
#   skillsmp-search.ts public site, no auth
flows/*
!flows/smoke.ts
!flows/google-search.ts
!flows/skillsmp-search.ts

# Kept on purpose: public/backdrop.jpg is a design asset, not pipeline output.
!public/backdrop.jpg

# Your brand mark, drawn on logo cards (LOGO_FILE in src/lib/intro.ts). Ignored
# for the same reason the flows are: it is one company's logo, not the engine's.
# Drop your own PNG here under this name.
public/logo-mark.png

# Intro copy is per-demo the same way flows are: it names that account's
# product and features. Same carve-out — the worked example is committed.
intros/*
!intros/smoke.ts

# Reel storyboards name a specific demo's product surface, same as flows/ and
# intros/. Nothing generic to commit yet.
reels/*

# Shot specs name one account's screens, same as flows/ and intros/. The
# captured PNGs and their sidecars are pipeline output; out/shots/ is already
# covered by the `out` rule above.
shots/*
!shots/smoke.ts
public/shots/
