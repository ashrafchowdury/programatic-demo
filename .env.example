# Copy to .env (gitignored) and fill in.

# --- Agenta instance -------------------------------------------------------
# Base URL of the Agenta instance to record against. Used as the fallback start
# URL for any flow that does not name its own.
AGENTA_BASE_URL=https://cloud.agenta.ai

# Optional: pre-fill the login email on the first `pnpm capture:session` run.
# You always type the password yourself, in the browser window.
# AGENTA_DEMO_EMAIL=you@example.com

# --- Per-demo start URLs ---------------------------------------------------
# Each live flow opens one playground. These are NOT in the repo because the URL
# embeds a workspace / project / app id unique to one account. Open the demo you
# want to record in your browser and paste the address bar here.
#
#   https://<host>/w/<workspace>/p/<project>/apps/<app>/playground?revisions=<rev>
#
# DEMO_URL_AGENT_INSTRUCTIONS=
# DEMO_URL_AGENT_SCHEDULE=
# DEMO_URL_AGENT_SKILL=
# DEMO_URL_AGENT_SUBSCRIPTION=

# --- Self-tour (optional) --------------------------------------------------
# Capture your own clicks, then replay them through the recorder:
#   DEMO_TOUR=capture pnpm record <name>    # you click; writes tours/<name>.json
#   DEMO_TOUR=replay  pnpm record <name>    # shoot the captured tour
# Unset = run the scripted flows/<name>.ts (the normal path).
# DEMO_TOUR=capture
#
# Start URL for `pnpm record <name>` capture (defaults to AGENTA_BASE_URL).
# Required for google-search / skillsmp-search — those flows navigate
# themselves, and capture does not run the flow.
# DEMO_TOUR_URL=https://html.duckduckgo.com/html/
