# Copy to .env (gitignored) and fill in.

# --- The app you are recording ---------------------------------------------
# Base URL of the app. Required by `pnpm capture:session`, and used as the
# fallback start URL for any flow that does not name its own.
APP_BASE_URL=https://example.com

# --- Per-demo start URLs ---------------------------------------------------
# Each live flow opens one screen. These are NOT in the repo because the URL
# usually embeds ids unique to one account. Open the screen you want to record
# in your browser and paste the address bar here, one key per flow:
#
#   DEMO_URL_<FLOW_NAME_IN_UPPER_SNAKE_CASE>=https://...
#
# DEMO_URL_MY_DEMO=
# DEMO_URL_NEW_AUTOMATION=
# DEMO_URL_HOURLY_AUTOMATION=
# DEMO_URL_NOTION_AUTOMATION=
# DEMO_URL_GMAIL_AUTOMATION=

# --- Rendering -------------------------------------------------------------
# GPU rasterisation. `angle` (default) needs a real GPU and is ~10x faster.
# Use `swiftshader` on CI or in a sandbox with no GPU — NOT `swangle`, which
# fails to decode the source video.
# DEMO_GL=swiftshader
#
# Playback speed vs the shoot. Default 1.25.
# DEMO_SPEED=1.5
#
# Render workers. Opt-in; more was measured slower. See scripts/lib/remotion.ts.
# DEMO_CONCURRENCY=1
#
# Default preset for `pnpm still`, when none is given on the command line.
# wide | og | square | portrait | story — see src/lib/still.ts.
# DEMO_PRESET=wide

# --- Recording -------------------------------------------------------------
# Show the browser during a shoot. Every recorder (record, record:live,
# record:batch, still) is headless by default; HEADLESS=0 is an alias.
# HEADED=1
#
# Capture path. Default `cdp`: lossless PNG frames straight from the
# compositor, placed on their own timestamps (recordings/<name>.mkv).
# `playwright` falls back to Playwright's recordVideo — 25fps, 1 Mbps VP8
# (recordings/<name>.webm). See scripts/lib/screencast.ts.
# DEMO_CAPTURE=playwright
#
# Frame rate of the CDP intermediate. 60 is exact at DEMO_SPEED 1, 1.5 and 2
# and ±8ms at the default 1.25; see CAPTURE_FPS in scripts/lib/screencast.ts.
# DEMO_CAPTURE_FPS=60
#
# Keep recordings/<name>.frames/ (the raw PNGs) after muxing, for debugging.
# DEMO_KEEP_FRAMES=1
#
# Physical capture = flow viewport x CAPTURE_SCALE (default 2). A capture
# narrower than the render needs at full zoom (3831px for a 2560 output) is
# refused; set DEMO_ALLOW_SOFT_CAPTURE=1 to record it anyway, e.g. for a flow
# that must run at CAPTURE_SCALE=1. See scripts/lib/capture-scale.ts.
# CAPTURE_SCALE=2
# DEMO_ALLOW_SOFT_CAPTURE=1
#
# Self-tour: capture your own clicks, then replay them through the recorder.
#   DEMO_TOUR=capture pnpm record <name>    # you click; writes tours/<name>.json
#   DEMO_TOUR=replay  pnpm record <name>    # shoot the captured tour
# DEMO_TOUR=capture
#
# Start URL for `pnpm record <name>` capture (defaults to APP_BASE_URL).
# DEMO_TOUR_URL=https://html.duckduckgo.com/html/
