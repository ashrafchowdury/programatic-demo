{
  "name": "programatic-demo",
  "version": "1.0.0",
  "description": "Programmatic product demo videos: Playwright records a real flow, Remotion adds Screen Studio-style camera, cursor and studio framing.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashrafchowdury/programatic-demo.git"
  },
  "license": "MIT",
  "dependencies": {
    "@remotion/cli": "4.0.506",
    "@remotion/media": "4.0.506",
    "@remotion/motion-blur": "4.0.506",
    "@remotion/tailwind-v4": "4.0.506",
    "dotenv": "^17.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.506",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@remotion/eslint-config-flat": "4.0.506",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "playwright": "^1.62.1",
    "prettier": "3.8.1",
    "tsx": "^4.23.8",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "record": "tsx scripts/record-demo.ts",
    "capture:session": "tsx scripts/capture-session.ts",
    "record:live": "tsx scripts/record-live.ts",
    "record:batch": "tsx scripts/record-batch.ts",
    "record:instructions": "tsx scripts/record-live.ts agent-instructions",
    "check:instructions": "tsx scripts/record-live.ts agent-instructions --check",
    "convert": "tsx scripts/convert.ts",
    "analyze": "tsx scripts/analyze.ts",
    "render": "tsx scripts/render.ts",
    "clip": "tsx scripts/clip.ts",
    "clip:smoke": "tsx scripts/clip.ts smoke",
    "clip:google": "tsx scripts/clip.ts google-search",
    "clip:skillsmp": "tsx scripts/clip.ts skillsmp-search",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "test": "tsx --test src/lib/*.test.ts scripts/lib/*.test.ts",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "keywords": [
    "remotion",
    "playwright",
    "product-demo",
    "screen-recording",
    "video",
    "screencast",
    "devrel",
    "documentation"
  ],
  "homepage": "https://github.com/ashrafchowdury/programatic-demo#readme",
  "bugs": {
    "url": "https://github.com/ashrafchowdury/programatic-demo/issues"
  }
}
